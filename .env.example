# Copy to .env and adjust. Defaults work with `docker compose up` out of the box.

# --- Postgres ---
POSTGRES_USER=chatgpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatgpt

# --- Backend ---
# Async SQLAlchemy URL. Inside compose the host is `db`; locally use `localhost`.
DATABASE_URL=postgresql+asyncpg://chatgpt:change-me@db:5432/chatgpt
REDIS_URL=redis://redis:6379/0

# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
# Browsers accept Secure cookies on http://localhost; set false only for plain-HTTP non-localhost hosts.
COOKIE_SECURE=true

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO

# --- LLM ---
# mock (default, no key needed) | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
